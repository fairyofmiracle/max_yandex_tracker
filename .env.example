# Шаблон окружения. Скопируй в .env и заполни локально.
# .env в git не коммитить.

# --- MAX (в публичном клоне можно оставить пустым) ---
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
WEBHOOK_URL=https://example.internal/max-tracker-v2/
MAX_API_BASE_URL=https://platform-api.max.ru

# --- Яндекс Трекер ---
TRACKER_ORG_ID=
TRACKER_QUEUE_ID=
TRACKER_API_BASE_URL=https://api.tracker.yandex.net
TRACKER_AUTH_MODE=oauth
TRACKER_OAUTH_TOKEN=

# --- LLM (локальный OpenAI-compatible endpoint) ---
LLM_PROVIDER=openai
LLM_API_BASE_URL=http://127.0.0.1:10000
LLM_CHAT_URL=http://127.0.0.1:10000/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gemma-local
LLM_CONNECT_TIMEOUT=5
LLM_REQUEST_TIMEOUT=90
LLM_MAX_TOOL_ROUNDS=6

# --- STT: GigaAM on-prem ---
STT_BACKEND=gigaam
GIGAAM_MODEL=v3_e2e_rnnt
GIGAAM_DEVICE=cuda
GIGAAM_MODEL_DIR=./models/gigaam
# Без весов — stub для локальных прогонов/CI:
STT_ALLOW_STUB=1

# --- Поведение агента ---
AGENT_REQUIRE_CONFIRM=1
AGENT_ASK_CLARIFY=1
AGENT_LANGUAGE=ru

# --- Рантайм ---
APP_HOST=0.0.0.0
APP_PORT=8013
LOG_LEVEL=INFO

# True = без реальных вызовов Трекера/MAX
DRY_RUN=1
